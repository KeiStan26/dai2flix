# ==============================================================================
# daini-vod Environment Configuration Example
# ==============================================================================
# CAUTION: Never commit actual API keys or secrets to version control.
# Copy this file to '.env' and fill in your actual credentials.

# ------------------------------------------------------------------------------
# External API Credentials
# ------------------------------------------------------------------------------
# YouTube Data API v3 Key (Required for sync_batch.py)
# Obtain from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# Google Gemini API Key (Required for AI enrichments: catchphrase, synopsis, tags)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# YouTube Target Channels & Playlists
# ------------------------------------------------------------------------------
# Daini Group Official YouTube Channel ID
# Example: UCbfRz3J6n7G4t1v1Kj9M2xA (Dummy format: starts with UC)
CHANNEL_ID=UC_SAMPLE_DAINI_GROUP_CHANNEL_ID

# Comma-separated YouTube Playlist IDs to sync explicitly (Optional)
# If empty, the batch syncs all public playlists or the channel's uploads playlist.
# Example: PL_SAMPLE_PLAYLIST_ID_1,PL_SAMPLE_PLAYLIST_ID_2
SYNC_PLAYLIST_IDS=

# ------------------------------------------------------------------------------
# Database & File Storage Settings
# ------------------------------------------------------------------------------
# SQLite connection URL (WAL mode will be enabled automatically)
DATABASE_URL=sqlite:///./dai2flix.db

# Lock file path to prevent concurrent sync executions
LOCK_FILE_PATH=./sync.lock

# ------------------------------------------------------------------------------
# Application & Logging Settings
# ------------------------------------------------------------------------------
# Server bind host and port (Used by FastAPI / Uvicorn)
HOST=127.0.0.1
PORT=8000

# Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
