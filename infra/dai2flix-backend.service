# ==============================================================================
# systemd service unit for DAI2FLIX FastAPI Backend
# Place at: /etc/systemd/system/dai2flix-backend.service
# ==============================================================================

[Unit]
Description=DAI2FLIX (dai2flix) FastAPI Backend Daemon
After=network.target
Documentation=https://github.com/your-username/dai2flix

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/dai2flix/backend

# Ensure Python can import packages from backend directory
Environment="PYTHONPATH=/var/www/dai2flix/backend"
# Environment file with secrets (chmod 600, '-' prefix makes it optional to prevent startup crash)
EnvironmentFile=-/var/www/dai2flix/backend/.env

# Executable invoking Uvicorn in virtualenv with explicit --app-dir
ExecStart=/var/www/dai2flix/.venv/bin/uvicorn app.main:app --app-dir /var/www/dai2flix/backend --host 127.0.0.1 --port 8008 --workers 2

# Automatic recovery and restart
Restart=always
RestartSec=5s

# Standard output and error to systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dai2flix-backend

# Defensive Security Hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
