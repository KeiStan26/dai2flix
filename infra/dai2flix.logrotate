# ==============================================================================
# logrotate configuration for DAI2FLIX batch logs
# Place at: /etc/logrotate.d/dai2flix
# ==============================================================================

/var/log/dai2flix/*.log {
    daily
    missingok
    rotate 14
    compress
    delaycompress
    notifempty
    create 0640 www-data www-data
    sharedscripts
    postrotate
        # Touch or notify if required
    endscript
}
